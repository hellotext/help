      "top": 2798,
      "text": "curl --request GET \\\n  --url https://api.hellotext.com/v1/profiles \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\"\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 1,
      "top": 3474,
      "text": "curl --request POST \\\n  --url https://api.hellotext.com/v1/properties \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\n    \"name\": \"ID del cliente\",\n    \"kind\": \"text\",\n    \"unique\": true\n  }'\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 2,
      "top": 4148,
      "text": "curl --request POST \\\n  --url https://api.hellotext.com/v1/profiles \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\n    \"first_name\": \"Ana\",\n    \"last_name\": \"Silva\",\n    \"email[primary]\": \"ana@example.test\",\n    \"property_by_id[PROPERTY_ID]\": \"customer-4821\"\n  }'\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 3,
      "top": 4958,
      "text": "curl --request POST \\\n  --url https://api.hellotext.com/v1/attribution/products \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\n    \"name\": \"Championes Everyday\",\n    \"reference\": \"product-100\",\n    \"sku\": \"SKU-100\",\n    \"source\": \"custom_store\",\n    \"url\": \"https://shop.example.com/products/everyday-sneakers\",\n    \"image_url\": \"https://shop.example.com/images/everyday-sneakers.jpg\",\n    \"price\": {\n      \"amount\": 89.90,\n      \"currency\": \"USD\"\n    },\n    \"categories\": [\"Calzado\"],\n    \"tags\": [\"Uso diario\"]\n  }'\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 4,
      "top": 6272,
      "text": "curl --request POST \\\n  --url https://api.hellotext.com/v1/attribution/orders \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\n    \"reference\": \"ORDER-1001\",\n    \"source\": \"custom_store\",\n    \"delivery\": \"deliver\",\n    \"items\": [\n      {\n        \"product\": \"PRODUCT_ID\",\n        \"quantity\": 1,\n        \"price\": {\n          \"amount\": 89.90,\n          \"currency\": \"USD\"\n        }\n      }\n    ]\n  }'\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 5,
      "top": 7000,
      "text": "curl --request POST \\\n  --url https://api.hellotext.com/v1/attribution/events \\\n  --header \"Authorization: Bearer $HELLOTEXT_API_TOKEN\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\n    \"action\": \"order.confirmed\",\n    \"profile\": \"PROFILE_ID\",\n    \"object\": \"ORDER_ID\",\n    \"amount\": 89.90,\n    \"currency\": \"USD\",\n    \"tracked_at\": 1751328000\n  }'\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 6,
      "top": 7874,
      "text": "npm install --save-exact @hellotext/hellotext@2.6.0\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 7,
      "top": 8034,
      "text": "import Hellotext from '@hellotext/hellotext'\n\nawait Hellotext.initialize('HELLOTEXT_BUSINESS_ID')\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 8,
      "top": 8784,
      "text": "<script src=\"https://unpkg.com/@hellotext/hellotext@2.6.0/dist/hellotext.js\"></script>\n<script>\n  Hellotext.initialize('HELLOTEXT_BUSINESS_ID')\n    .then(() => Hellotext.track('page.viewed'))\n    .then(response => {\n      if (response.failed) console.error(response.data)\n    })\n    .catch(error => console.error(error))\n</script>\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 9,
      "top": 9346,
      "text": "const pageResponse = await Hellotext.track('page.viewed')\n\nif (pageResponse.failed) {\n  console.error(pageResponse.data)\n}\n",
      "width": 774,
      "scrollWidth": 774
    },
    {
      "i": 10,
      "top": 9778,
      "text": "await Hellotext.track('product.viewed', {\n  object: 'PRODUCT_ID',\n})\n",
