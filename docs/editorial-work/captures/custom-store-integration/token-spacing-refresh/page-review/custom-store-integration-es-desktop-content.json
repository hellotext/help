      "top": 10010,
      "text": "await Hellotext.track('product.viewed', {\n  object_parameters: {\n    name: 'Championes Everyday',\n    reference: 'product-100',\n    source: 'custom_store',\n    url: window.location.href,\n    image_url: 'https://shop.example.com/images/everyday-sneakers.jpg',\n    price: {\n      amount: 89.90,\n      currency: 'USD',\n    },\n  },\n})\n",
