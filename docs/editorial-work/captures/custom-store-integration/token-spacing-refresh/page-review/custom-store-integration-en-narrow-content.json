      "text": "await Hellotext.track('order.placed', {\n  amount: 89.90,\n  currency: 'USD',\n  object_parameters: {\n    reference: 'ORDER-1001',\n    source: 'custom_store',\n    delivery: 'deliver',\n    items: [\n      {\n        product: 'PRODUCT_ID',\n        quantity: 1,\n      },\n    ],\n  },\n})\n",
      "width": 548,
