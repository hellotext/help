  "current_difference": "input_controller.js adds composer timing instrumentation around initialization/connect/restore/dispatch only; formatting/hotkey and Link contracts unchanged. Capture protected reviewed UI; no Rails/config update.",
  "primary_sources": [
    "https://github.com/basecamp/trix#creating-a-toolbar"
  ],
  "contracts": [
    "Native Message actual keyboard shortcuts produce strong/em HTML; source preventDefault alone cannot infer final event order; CDP keyboard review retained",
    "Message versus paired Email editor and per-channel plain-text rendering; SMS preview strips formatting; preview is not acceptance/delivery",
    "Custom tracked Link tool opens at the caret through Ctrl/Command K; Add or Enter performs POST and creates Link before final message/template save",
    "Current tracked Link popup has one static URL field, no label or named dynamic parameter; no link created to manufacture screenshot",
    "Link creation, recipient-specific ShortLink, click/session/profile/attributed sale are separate states",
    "Unsaved native template editor new GET builds unsaved Template; no POST, saved template/version/approval or outgoing message executed",
    "Both actual SMS gateways pass Message.plain_text; Trixable renders body.to_plain_text. Source-only inspection; no message or provider method executed."
  ],
  "operations": "Read-only primary sources and docs; only unsaved local DOM draft and keyboard/link-tool review; no persistence, Link, ShortLink, outgoing message or worker."
}
